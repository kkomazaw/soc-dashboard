{
  "name": "soc-dashboard",
  "version": "1.0.0",
  "description": "Security Operation Center Dashboard for monitoring vulnerabilities and threat intelligence",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "build": "tsc && vite build && electron-builder",
    "build:analyze": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "keywords": [
    "security",
    "soc",
    "dashboard",
    "vulnerability",
    "threat-intelligence"
  ],
  "author": "SOC Dashboard Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "@tanstack/react-query": "^5.12.2",
    "@types/pdfkit": "^0.17.7",
    "axios": "^1.6.2",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "d3-scale": "^4.0.3",
    "date-fns": "^2.30.0",
    "docx": "^9.15.3",
    "dotenv": "^18.0.9",
    "express": "^4.18.2",
    "json2csv": "^6.0.0-alpha.2",
    "lucide-react": "^0.294.0",
    "node-cron": "^3.0.3",
    "papaparse": "^5.7.0",
    "pdfkit": "^0.20.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "react-simple-maps": "^5.0.5",
    "recharts": "^3.10.1",
    "rss-parser": "^3.13.0",
    "twitter-api-v2": "^1.31.0",
    "web-vitals": "^6.2.3",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tanstack/react-query-devtools": "^5.105.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.4",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.32",
    "prisma": "^5.7.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^3.3.6",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "vite": "^5.0.7",
    "vite-plugin-pwa": "^2.0.0",
    "wait-on": "^7.2.0",
    "workbox-window": "^7.4.1"
  }
}
