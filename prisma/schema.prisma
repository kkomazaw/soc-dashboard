// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// CISA KEV (Known Exploited Vulnerabilities)
model CisaKev {
  id                            Int       @id @default(autoincrement())
  cveId                         String    @unique @map("cve_id")
  vendorProject                 String?   @map("vendor_project")
  product                       String?
  vulnerabilityName             String?   @map("vulnerability_name")
  dateAdded                     DateTime  @map("date_added")
  shortDescription              String?   @map("short_description")
  requiredAction                String?   @map("required_action")
  dueDate                       DateTime? @map("due_date")
  knownRansomwareCampaignUse    Boolean?  @map("known_ransomware_campaign_use")
  notes                         String?
  createdAt                     DateTime  @default(now()) @map("created_at")
  updatedAt                     DateTime  @updatedAt @map("updated_at")

  @@index([cveId])
  @@index([dateAdded])
  @@map("cisa_kev")
}

// JVN Vulnerabilities
model JvnVulnerability {
  id                Int       @id @default(autoincrement())
  jvnId             String    @unique @map("jvn_id")
  cveId             String?   @map("cve_id")
  title             String
  summary           String?
  severity          String?
  cvssScore         Float?    @map("cvss_score")
  cvssVector        String?   @map("cvss_vector")
  publishedDate     DateTime? @map("published_date")
  lastModifiedDate  DateTime? @map("last_modified_date")
  affectedProducts  String?   @map("affected_products") // JSON string
  references        String?   // JSON string
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([jvnId])
  @@index([cveId])
  @@index([publishedDate])
  @@map("jvn_vulnerabilities")
}

// News Articles
model NewsArticle {
  id             Int       @id @default(autoincrement())
  guid           String    @unique
  title          String
  link           String
  description    String?
  content        String?
  author         String?
  source         String    // 'bleepingcomputer', 'thehackernews', etc.
  category       String?   // 'vulnerability', 'ransomware', 'apt', etc.
  publishedDate  DateTime  @map("published_date")
  isRead         Boolean   @default(false) @map("is_read")
  isStarred      Boolean   @default(false) @map("is_starred")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([source])
  @@index([category])
  @@index([publishedDate])
  @@index([isRead])
  @@map("news_articles")
}

// NVD CVE Data
model NvdCve {
  id                Int       @id @default(autoincrement())
  cveId             String    @unique @map("cve_id")
  sourceIdentifier  String?   @map("source_identifier")
  published         DateTime
  lastModified      DateTime  @map("last_modified")
  vulnStatus        String?   @map("vuln_status")
  description       String?
  cvssScore         Float?    @map("cvss_score")
  cvssSeverity      String?   @map("cvss_severity")
  cvssVector        String?   @map("cvss_vector")
  cvssVersion       String?   @map("cvss_version")
  weaknesses        String?   // JSON string array of CWE IDs
  references        String?   // JSON string array of reference URLs
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([cveId])
  @@index([published])
  @@index([cvssScore])
  @@map("nvd_cves")
}

// MITRE ATT&CK Techniques
model AttackTechnique {
  id                  Int       @id @default(autoincrement())
  techniqueId         String    @unique @map("technique_id") // T1566, T1070, etc.
  name                String
  description         String?
  tactics             String?   // JSON string array
  platforms           String?   // JSON string array
  dataSource          String?   @map("data_source") // JSON string array
  detectionDifficulty String?   @map("detection_difficulty")
  url                 String?
  mitigations         String?   // JSON string array
  subtechniques       String?   // JSON string array
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([techniqueId])
  @@map("attack_techniques")
}

// MITRE ATT&CK Tactics
model AttackTactic {
  id          Int       @id @default(autoincrement())
  tacticId    String    @unique @map("tactic_id") // TA0001, TA0002, etc.
  name        String
  description String?
  shortName   String    @map("short_name") // initial-access, execution, etc.
  techniques  String?   // JSON string array of technique IDs
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([tacticId])
  @@index([shortName])
  @@map("attack_tactics")
}

// CVE to ATT&CK Technique Mapping
model CveAttackMapping {
  id           Int      @id @default(autoincrement())
  cveId        String   @map("cve_id") // CVE-2024-1234
  techniqueId  String   @map("technique_id") // T1566
  source       String   // 'cisa', 'jvn', 'nvd'
  confidence   String   @default("medium") // 'high', 'medium', 'low'
  matchType    String   @map("match_type") // 'keyword', 'tactic', 'manual'
  matchDetails String?  @map("match_details") // JSON string with match information
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([cveId, techniqueId, source])
  @@index([cveId])
  @@index([techniqueId])
  @@index([source])
  @@map("cve_attack_mappings")
}

// Red Hat Security Advisories
model RedHatAdvisory {
  id                Int       @id @default(autoincrement())
  advisoryId        String    @unique @map("advisory_id") // RHSA-2024:0001
  advisoryType      String    @map("advisory_type") // RHSA, RHBA, RHEA
  severity          String?   // Critical, Important, Moderate, Low
  synopsis          String
  description       String?
  publicDate        DateTime  @map("public_date")
  cves              String?   // JSON string array of CVE IDs
  affectedPackages  String?   @map("affected_packages") // JSON string array
  bugzilla          String?   // JSON string array of bugzilla entries
  resourceUrl       String?   @map("resource_url")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([advisoryId])
  @@index([publicDate])
  @@index([severity])
  @@map("redhat_advisories")
}

// Red Hat CVE Data
model RedHatCve {
  id                Int       @id @default(autoincrement())
  cveId             String    @unique @map("cve_id")
  severity          String?
  publicDate        DateTime  @map("public_date")
  advisories        String?   // JSON string array of advisory IDs
  bugzillaId        String?   @map("bugzilla_id")
  bugzillaDesc      String?   @map("bugzilla_desc")
  cvssScore         String?   @map("cvss_score")
  cvssVector        String?   @map("cvss_vector")
  cvss3Score        String?   @map("cvss3_score")
  cvss3Vector       String?   @map("cvss3_vector")
  cwe               String?
  details           String?   // JSON string array
  affectedPackages  String?   @map("affected_packages") // JSON string
  resourceUrl       String?   @map("resource_url")
  references        String?   // JSON string array
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([cveId])
  @@index([publicDate])
  @@index([severity])
  @@map("redhat_cves")
}

// EPSS (Exploit Prediction Scoring System)
model EpssScore {
  id            Int      @id @default(autoincrement())
  cveId         String   @unique @map("cve_id")
  epss          Float    // EPSS score (0.0-1.0, probability of exploitation in next 30 days)
  percentile    Float    // Percentile ranking (0.0-1.0)
  modelVersion  String   @map("model_version")
  scoreDate     DateTime @map("score_date") // Date this score was calculated
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([cveId])
  @@index([epss])
  @@index([scoreDate])
  @@map("epss_scores")
}

// IP Threat Reports (raw data from threat intelligence sources)
model IpThreatReport {
  id                Int       @id @default(autoincrement())
  ipAddress         String    @map("ip_address")
  countryCode       String    @map("country_code") // ISO 3166-1 alpha-2 (US, CN, RU, etc.)
  country           String
  threatType        String    @map("threat_type") // 'malware', 'phishing', 'scanning', 'ddos', etc.
  severity          String    // 'critical', 'high', 'medium', 'low'
  confidence        Int       // Confidence score 0-100
  source            String    // 'abuseipdb', 'otx', 'internal'
  sourceReportId    String?   @map("source_report_id") // External ID from the source
  description       String?
  reportedDate      DateTime  @map("reported_date")
  metadata          String?   // JSON string with additional details
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([ipAddress, source, reportedDate], name: "ipAddress_source_reportedDate")
  @@index([ipAddress])
  @@index([countryCode])
  @@index([reportedDate])
  @@index([severity])
  @@index([source])
  @@map("ip_threat_reports")
}

// Geographic Threat Aggregation (pre-calculated statistics by country)
model GeoThreatAggregation {
  id               Int       @id @default(autoincrement())
  countryCode      String    @unique @map("country_code")
  country          String
  threatCount      Int       @map("threat_count")
  criticalCount    Int       @map("critical_count")
  highCount        Int       @map("high_count")
  mediumCount      Int       @map("medium_count")
  lowCount         Int       @map("low_count")
  topThreats       String    @map("top_threats") // JSON string array of most common threat types
  uniqueIps        Int       @map("unique_ips") // Count of unique malicious IPs
  lastReportDate   DateTime  @map("last_report_date")
  calculatedAt     DateTime  @map("calculated_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([countryCode])
  @@index([threatCount])
  @@index([calculatedAt])
  @@map("geo_threat_aggregations")
}

// Vendor Patches (Microsoft, Cisco, VMware, Oracle, etc.)
model VendorPatch {
  id                Int       @id @default(autoincrement())

  // Vendor Information
  vendor            String    // Microsoft, RedHat, Cisco, VMware, Oracle, etc.
  product           String    // Windows, Office, RHEL, IOS, ESXi, etc.
  productVersion    String?   @map("product_version") // 10, 11, 2019, 8.0, etc.

  // Patch Information
  patchId           String    @unique @map("patch_id") // KB5001234, cisco-sa-*, VMSA-*, etc.
  title             String
  description       String?
  severity          String    // Critical, Important/High, Moderate/Medium, Low

  // CVE Related
  cveIds            String?   @map("cve_ids") // JSON array of CVE IDs
  cveCount          Int       @default(0) @map("cve_count")

  // Release Information
  releaseDate       DateTime  @map("release_date")
  releaseType       String    @default("regular") @map("release_type") // regular, out-of-band, emergency

  // Links
  bulletinUrl       String?   @map("bulletin_url")
  downloadUrl       String?   @map("download_url")
  kbArticleUrl      String?   @map("kb_article_url")

  // Metadata
  supersedes        String?   // JSON array of patch IDs this replaces
  supersededBy      String?   @map("superseded_by") // JSON array of newer patches
  affectedSystems   String?   @map("affected_systems") // JSON array of system names

  // Deployment Status Tracking
  deploymentStatus  String    @default("pending") @map("deployment_status") // pending, testing, deployed, skipped
  deploymentDate    DateTime? @map("deployment_date")
  deploymentNotes   String?   @map("deployment_notes")

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([vendor])
  @@index([severity])
  @@index([releaseDate])
  @@index([deploymentStatus])
  @@index([patchId])
  @@map("vendor_patches")
}

// App Settings
model AppSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String?
  type      String   @default("string") // 'string', 'number', 'boolean', 'json'
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([key])
  @@map("app_settings")
}
