# Database
DATABASE_URL="file:./dev.db"

# API Keys (optional for MVP)
# VIRUSTOTAL_API_KEY=your_api_key_here
# ABUSEIPDB_API_KEY=your_api_key_here
# NVD_API_KEY=your_api_key_here
# OTX_API_KEY=your_api_key_here

# Patch Management APIs
# MSRC_API_KEY=your_api_key_here  # Microsoft Security Response Center API
# CISCO_CLIENT_ID=your_client_id_here  # Cisco PSIRT API (register at apiconsole.cisco.com)
# CISCO_CLIENT_SECRET=your_client_secret_here

# Twitter API v2 (required for Twitter feed)
# Get your Bearer Token from: https://developer.twitter.com/en/portal/dashboard
# TWITTER_BEARER_TOKEN=your_bearer_token_here

# Twitter Mock Data (for development/testing)
# Set to 'true' to use mock data instead of real API (avoids rate limits)
# USE_TWITTER_MOCK=false
